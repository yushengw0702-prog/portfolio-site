{
  "manifest_version": 3,
  "name": "飞书宋体",
  "version": "2.0",
  "description": "让浏览器版飞书使用宋体字体，支持自定义字体和背景颜色",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞书宋体设置"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.feishu.cn/*",
        "*://*.larksuite.com/*"
      ],
      "css": ["songti.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
